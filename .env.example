# ==========================================
# HackHub - Environment Configuration
# ==========================================

# Server environment (development | production | test)
NODE_ENV=development

# Server port
PORT=5000

# Client Vite dev server port
CLIENT_PORT=5173

# MongoDB Connection String
# Local standard default: mongodb://127.0.0.1:27017/hackhub
# Docker Compose default: mongodb://mongo:27017/hackhub
MONGODB_URI=mongodb://127.0.0.1:27017/hackhub

# CORS Allowed Origin
CORS_ORIGIN=*
