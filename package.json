{
  "name": "hack-hub",
  "version": "0.1.0",
  "private": true,
  "description": "HackHub - Self-Hostable Hackathon Management Platform (MERN Stack)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
